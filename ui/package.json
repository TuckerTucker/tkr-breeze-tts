{
  "name": "@breeze-tts/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The browser surface: three voice modes, streaming playback, an honest wake state, a voice library, and a script editor.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
