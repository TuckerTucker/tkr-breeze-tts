{
  "name": "@breeze-tts/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The browser surface: task-first voice creation, saved-voice speech, streaming playback, honest wake state, and capability-gated script tools.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 && npm run lint:exports",
    "lint:exports": "ts-unused-exports tsconfig.json --allowUnusedTypes '--ignoreFiles=vite.config'",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^3.2.7",
    "eslint": "10.10.0",
    "eslint-import-resolver-node": "0.3.9",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "^25.0.1",
    "ts-unused-exports": "11.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.69.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
