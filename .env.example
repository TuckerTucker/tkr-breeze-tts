# Breeze-TTS demo — environment template.
#
# Copy to `.env` and fill in the credential values:
#
#     cp .env.example .env
#
# `.env` is gitignored; this template is not. Never put a real key in here.
#
# One file at the repo root, not one per capability: the gateway and the bench
# (_tkr_kit measurement) both authenticate to the same Modal endpoint, and a
# second copy of a credential is a second thing to leak and rotate.

# ── Modal endpoint and proxy auth ────────────────────────────────────────────
# The deployed web endpoint, e.g. https://<workspace>--breeze-tts-serve.modal.run
# The browser never sees this — only the gateway process does.
MODAL_ENDPOINT_URL=

# Proxy auth token pair, created in your Modal workspace settings. These are sent
# as the Modal-Key / Modal-Secret headers, attached server-side by the gateway.
# The service sets requires_proxy_auth, so without these the endpoint is closed —
# which is deliberate: the Breeze-TTS-2 weights are research / non-commercial, and
# an open .modal.run URL serving them is a materially different act from running
# them locally.
MODAL_KEY=
MODAL_SECRET=

# The transcription endpoint, printed by `modal deploy infra/asr.py`. Optional:
# without it, reference intake still works and the transcript is typed by hand,
# the same way a missing ffmpeg degrades rather than fails.
MODAL_ASR_URL=

# ── Gateway ──────────────────────────────────────────────────────────────────
# The UI is served from this same origin, so CORS never arises.
GATEWAY_PORT=8787

# Playback transport: `streaming` pipes raw PCM through unbuffered and is the
# path the sub-40ms claim depends on; `buffered` returns a complete WAV and is
# the safety net while the AudioWorklet is being made to behave. Both accept an
# identical request, so switching is invisible to the browser.
GATEWAY_TRANSPORT=streaming

# Clip cache. Stores raw PCM plus a sidecar carrying rate, format and request
# provenance; WAV framing happens at read. Oldest-first eviction at the limit.
CLIP_CACHE_DIR=.cache/clips
CLIP_CACHE_MAX_BYTES=2147483648

# Voice library. Separate from the clip cache on purpose — clips are exhaust and
# get evicted, voices are kept and own their own copy of the audio.
VOICE_STORE_DIR=.cache/voices

# Staged references are working material, separate from both generated clips
# and durable voices. The WAV and its timed-transcript sidecar expire together.
REFERENCE_STORE_DIR=.cache/references
REFERENCE_MAX_AGE_MS=86400000

# ── Not here on purpose ──────────────────────────────────────────────────────
# GPU type, scaledown_window, min_containers and requires_proxy_auth are the
# deployment posture, and modal-inference/slice/4 puts them in infra/config.py as
# one configuration surface. They are read at decoration time by the serving
# class, not from this file. The recognition service has its own set of those
# (BREEZE_ASR_GPU, BREEZE_ASR_SCALEDOWN_WINDOW_S, BREEZE_ASR_COMPUTE_TYPE and
# siblings) for the same reason and in the same place — the two services want
# opposite warm postures, so one pair of knobs would be wrong for one of them.
