# Breeze-TTS demo — environment template.
#
# Copy to `.env` and fill in the credential values:
#
#     cp .env.example .env
#
# `.env` is gitignored; this template is not. Never put a real key in here.
#
# One file at the repo root, not one per capability: the gateway and the bench
# (_tkr_kit measurement) both authenticate to the same Modal endpoint, and a
# second copy of a credential is a second thing to leak and rotate.

# ── Modal endpoint and proxy auth ────────────────────────────────────────────
# The deployed web endpoint, e.g. https://<workspace>--breeze-tts-serve.modal.run
# The browser never sees this — only the gateway process does.
MODAL_ENDPOINT_URL=

# Proxy auth token pair, created with `modal workspace proxy-tokens create --json`.
# These are sent as Modal-Key / Modal-Secret headers, attached server-side by the gateway.
# The service sets requires_proxy_auth, so without these the endpoint is closed —
# which is deliberate: the Breeze-TTS-2 weights are research / non-commercial, and
# an open .modal.run URL serving them is a materially different act from running
# them locally.
MODAL_KEY=
MODAL_SECRET=

# The transcription endpoint, printed by `modal deploy infra/asr.py`. Optional:
# without it, reference intake still works and the transcript is typed by hand,
# the same way a missing ffmpeg degrades rather than fails.
MODAL_ASR_URL=

# ── Gateway ──────────────────────────────────────────────────────────────────
# The UI is served from this same origin, so CORS never arises.
GATEWAY_PORT=8787

# Must match the synthesis service's BREEZE_SCALEDOWN_WINDOW_S. Readiness is
# inferred from idle time against this value; the gateway never polls a sleeping
# GPU to ask whether it is asleep.
GATEWAY_SCALEDOWN_WINDOW_S=600

# Covers container startup, model load, graph capture, and synthesis. A shorter
# value can abort a valid first request while the GPU is still becoming ready.
GATEWAY_UPSTREAM_TIMEOUT_MS=900000

# Playback transport: `streaming` pipes raw PCM through unbuffered so first audio
# is observed as it arrives; `buffered` returns a complete WAV as a compatibility
# path. Both accept an identical request, so switching is invisible to the browser.
GATEWAY_TRANSPORT=streaming

# Clip cache. Stores raw PCM plus a sidecar carrying rate, format and request
# provenance; WAV framing happens at read. Oldest-first eviction at the limit.
CLIP_CACHE_DIR=.cache/clips
CLIP_CACHE_MAX_BYTES=2147483648

# Voice library. Separate from the clip cache on purpose — clips are exhaust and
# get evicted, voices are kept and own their own copy of the audio.
VOICE_STORE_DIR=.cache/voices

# Script documents are durable even while their active browser workspace is
# capability-gated. Generated cue audio remains in the clip cache.
SCRIPT_STORE_DIR=.cache/scripts

# Staged references are working material, separate from both generated clips
# and durable voices. The WAV and its timed-transcript sidecar expire together.
REFERENCE_STORE_DIR=.cache/references
REFERENCE_MAX_AGE_MS=86400000

# Recorded measurement inputs and the built UI served by the gateway.
BENCH_FINDINGS_DIR=bench/findings
UI_DIST_DIR=ui/dist

# Structured gateway log threshold.
LOG_LEVEL=info

# ── Modal deployment-time shell environment ──────────────────────────────────
# These values are intentionally not active `.env` assignments. infra/config.py
# reads the environment of `modal deploy`; the local gateway's dotenv loader does
# not configure a remote deployment. Export them in the deployment shell or pass
# them inline, for example:
#
#   BREEZE_GPU=L40S BREEZE_SCALEDOWN_WINDOW_S=600 modal deploy infra/service.py
#
# Synthesis defaults:
#   BREEZE_GPU=H100
#   BREEZE_PIN_GPU=1
#   BREEZE_SCALEDOWN_WINDOW_S=600
#   BREEZE_MIN_CONTAINERS=             # unset means scale to zero
#   BREEZE_TIMEOUT_S=900
#   BREEZE_REQUIRES_PROXY_AUTH=1
#
# Recognition defaults:
#   BREEZE_ASR_GPU=L4
#   BREEZE_ASR_PIN_GPU=1
#   BREEZE_ASR_SCALEDOWN_WINDOW_S=120
#   BREEZE_ASR_MIN_CONTAINERS=         # unset means scale to zero
#   BREEZE_ASR_REQUIRES_PROXY_AUTH=1
#   BREEZE_ASR_COMPUTE_TYPE=float16
#   BREEZE_ASR_BEAM_SIZE=5
